    "mcp": "node mcp/server.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "playwright-core": "^1.64.1",
    "zod": "^4.6.7"
  }
}
