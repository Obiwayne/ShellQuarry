{
  "name": "shellquarry",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "The browser shell for Herdr: a terminal and a browser side panel your agents drive over MCP.",
  "license": "MIT",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "dev": "npm run vendor && tauri dev",
    "build": "node scripts/build.mjs",
    "themes": "node scripts/port-herdr-themes.mjs",
    "icons": "node scripts/render-icon.mjs && tauri icon assets/icon.png -o src-tauri/icons"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2.12.4",
    "playwright-core": "^1.64.1"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0"
  }
}
