{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShellQuarry",
  "version": "0.1.0",
  "identifier": "dev.repoquarry.shellquarry",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "RepoQuarry",
    "copyright": "MIT licence",
    "category": "DeveloperTool",
    "shortDescription": "Agent terminal with a built-in browser panel",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
